# Copy this file to .env in the repository root, then edit the values.
# Absolute HOST folder containing gcp-oauth.keys.json and credentials.json.
# Compose mounts this folder at /run/gmail inside the application container.
GMAIL_MCP_DIR=/absolute/path/to/your/gmail-mcp

# Replace these example numbers with `id -u` and `id -g` on the Linux server.
# Commands are not executed inside .env files; enter the actual numbers.
MAILSORT_UID=1000
MAILSORT_GID=1000
