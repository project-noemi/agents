# Inventory only. Never put real values in this file or commit them.
# Sprint 2+ keys are injected at runtime by:
#   infisical run --env=dev -- <command>
#   op run --env-file=.env.template -- <command>
# This package does not load dotenv.
#
# Live providers go through NewPush's generative AI gateway. One virtual key
# (sk-...) serves both gemini and xai. It is not a Google or xAI credential.
# AI_GW_API_KEY=
# AI_GW_BASE_URL=
# GEMINI_MODEL=
# GEMINI_TIMEOUT_MS=
# XAI_MODEL=
# XAI_TIMEOUT_MS=
# AI_GW_MAX_RETRIES=
# AI_GW_RETRY_BASE_MS=
# NOEMI_PREFERRED_PROVIDER=mock
# NOEMI_FALLBACK_PROVIDERS=
# NOEMI_REPO_ROOT=
