# Guardian Layer — Required Environment Variables (Fetch-on-Demand)
# Inject at runtime; never commit real values. Use vault references only.
#   op run --env-file=guardian-layer/.env.example -- python3 guardian-layer/guardian_evaluator.py
#   infisical run --env=dev -- python3 guardian-layer/guardian_evaluator.py
#
# The module also runs fully offline (built-in heuristic judge) with no env set.

# Judge model credential (Gemini 2.5 Flash). GOOGLE_API_KEY is also accepted.
GEMINI_API_KEY=op://noemi/google/gemini-api-key

# Optional: Loki push endpoint for the NewPush Labs observability stack.
# When unset, log_to_loki() writes the Loki-formatted record to stderr.
LOKI_PUSH_URL=op://noemi/loki/push-url
