# Copy this file to .env in the repository root, then edit the values.
# File mode only (compose.credentials-files.yaml): absolute HOST folder containing
# gcp-oauth.keys.json and credentials.json. Compose mounts it read-only at
# /run/gmail. Vault mode (compose.credentials-vault.yaml) does not use it; the
# OAuth JSON then comes from your vault, never from this file.
GMAIL_MCP_DIR=/absolute/path/to/your/gmail-mcp

# Replace these example numbers with `id -u` and `id -g` on the Linux server.
# Commands are not executed inside .env files; enter the actual numbers.
MAILSORT_UID=1000
MAILSORT_GID=1000
