    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const item = $input.item.json;\nconst raw = (item.esemenyek && typeof item.esemenyek === 'object') ? item.esemenyek : item;\n\nconst cleanStr = (v) => (typeof v === 'string' ? v.replace(/\\s+/g, ' ').trim() : '');\n\nconst esemeny_azonosito = cleanStr(raw.esemeny_id || raw.id) || `EVT-${$execution.id}-${$itemIndex + 1}`;\nconst batch_id = cleanStr(item.batch_id || raw.batch_id) || `BATCH-${$execution.id}`;\nconst ugyfel_nev = cleanStr(raw.nev || raw.name || raw.ugyfel_nev);\nconst ugyfel_email = cleanStr(raw.email || raw.ugyfel_email).toLowerCase();\nconst ceg = cleanStr(raw.ceg || raw.company) || 'Nincs megadva';\nconst targy = cleanStr(raw.targy || raw.subject) || 'Kapcsolatfelvételi megkeresés';\nconst uzenet = cleanStr(raw.uzenet || raw.message);\nconst forras = cleanStr(raw.forras || raw.source) || 'webhook-batch';\nconst api_szimulacio = raw.api_szimulacio === 'hiba_503' ? 'hiba_503' : 'ok';\n\nconst nyersId = Number.parseInt(raw.kulso_ugyfel_id ?? raw.user_id, 10);\nconst kulso_ugyfel_id = Number.isInteger(nyersId) && nyersId >= 1 && nyersId <= 10 ? nyersId : (($itemIndex % 10) + 1);\n\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nconst hianyzo_mezok = [];\nif (ugyfel_nev.length < 2) hianyzo_mezok.push('nev');\nif (!emailRegex.test(ugyfel_email)) hianyzo_mezok.push('ervenyes_email');\nif (uzenet.length < 5) hianyzo_mezok.push('uzenet');\n\nconst ervenyes = hianyzo_mezok.length === 0;\n\nreturn {\n  json: {\n    esemeny_azonosito,\n    batch_id,\n    ugyfel_nev,\n    ugyfel_email,\n    ceg,\n    targy,\n    uzenet,\n    forras,\n    kulso_ugyfel_id,\n    api_szimulacio,\n    ervenyes,\n    validacios_allapot: ervenyes ? 'ERVENYES' : 'ELUTASITVA',\n    hianyzo_mezok,\n    tisztitva_e: true,\n    beerkezett: new Date().toISOString()\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
