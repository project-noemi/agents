              "type": "string"
            },
            {
              "id": "s2",
              "name": "email",
              "value": "={{ String($json.event.email ?? '').trim().toLowerCase() }}",
              "type": "string"
            },
            {
              "id": "s3",
              "name": "amount",
              "value": "={{ Number(String($json.event.amount ?? '').replace(/[^0-9.]/g, '')) || 0 }}",
              "type": "number"
            },
            {
              "id": "s4",
              "name": "simulate_failure",
              "value": "={{ $json.event.simulate_failure === true }}",
              "type": "boolean"
            },
            {
              "id": "s5",
              "name": "reject_reason",
              "value": "={{ !String($json.event.id ?? '').trim() ? 'missing id' : !String($json.event.email ?? '').includes('@') ? 'missing or invalid email' : !((Number(String($json.event.amount ?? '').replace(/[^0-9.]/g, '')) || 0) > 0) ? 'missing or invalid amount' : '' }}",
              "type": "string"
            }
          ]
