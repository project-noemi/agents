{
  "version": 1,
  "$comment": "Issue-coding loop model contract. Hosts discover per-stage family using the same rule as the fleet reviewer (Decision [2026-08-16-0002], [2026-08-16-0004]). See docs/architecture/issue-coding-loop.md. Optional per-stage pin overrides discovery.",
  "selectionDefault": "highest-preview-then-stable",
  "planRedTeam": {
