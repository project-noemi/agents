      "family": "fable-5-max",
      "selection": "highest-preview-then-stable"
    },
    "plan": {
      "provider": "anthropic",
      "family": "fable-5-max",
      "selection": "highest-preview-then-stable"
    },
    "code": {
      "provider": "xai",
      "family": "grok-latest",
      "effort": "xhigh",
      "selection": "highest-preview-then-stable"
    },
    "redteam": {
      "provider": "google",
      "family": "gemini-pro",
      "selection": "highest-preview-then-stable"
    }
  }
}
