      "name": "Webhook (Batch Ingestion)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -544,
        48
      ],
      "webhookId": "batch-inquiry"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst result = [];\n\nfor (const item of items) {\n  let body = item.json.body || item.json;\n  \n  if (!Array.isArray(body)) {\n    body = [body];\n  }\n  \n  for (const raw of body) {\n    result.push({\n      json: {\n        eventId: raw.eventId || 'EVT-' + Math.floor(Math.random() * 100000),\n        customerEmail: (raw.customerEmail || '').trim().toLowerCase(),\n        subject: (raw.subject || '').trim(),\n        priority: (raw.priority || 'standard').trim().toLowerCase(),\n        timestamp: new Date().toISOString()\n      }\n    });\n  }\n}\n\nreturn result;"
      },
      "id": "76242e04-8c62-40ac-b5e0-1b21accfc428",
